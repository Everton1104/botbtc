<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Permissão de internet — sem ela nenhuma chamada à API sai do aparelho.
         (A build de debug já acrescenta isso sozinha, mas a release não.) -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Notificações: desde o Android 13 o usuário aprova em tempo de execução
         (o app pede com um diálogo na primeira vez — ver servicos/notificacoes.dart). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Auto-atualização: o app baixa o APK novo e dispara o instalador do
         sistema. O Android 8+ pede ao usuário (uma vez só) a autorização
         "instalar apps desta fonte" na primeira instalação; sem esta
         permissão declarada, o instalador recusa direto. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <application
        android:name="${applicationName}"
        android:label="BotBTC"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Auto-atualização: expõe o APK baixado (cache interno) pro
             instalador do sistema via content:// — o Android 7+ exige
             FileProvider, não aceita file:// cru. Paths em res/xml/file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Visibilidade do instalador de pacotes (Android 11+ exige declarar
             o que o app pode "enxergar"): disparar o APK baixado depende
             disto. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:mimeType="application/vnd.android.package-archive"/>
        </intent>
    </queries>
</manifest>
